[bgcolor=#33405e][color=#ffffff][b] 1 [/b][/color][/bgcolor] [bgcolor=#33405e][color=#ffffff][b] 2 [/b][/color][/bgcolor] [bgcolor=#33405e][color=#ffffff][b] 3 [/b][/color][/bgcolor] [bgcolor=#33405e][color=#ffffff][b] 4 [/b][/color][/bgcolor] — answer a question (or click / tap)
[bgcolor=#33405e][color=#ffffff][b] H [/b][/color][/bgcolor] — ask a teammate for help
[bgcolor=#33405e][color=#ffffff][b] Y [/b][/color][/bgcolor] / [bgcolor=#33405e][color=#ffffff][b] N [/b][/color][/bgcolor] — accept / refuse a help request
[bgcolor=#33405e][color=#ffffff][b] Esc [/b][/color][/bgcolor] — close a window; pause the game (host only)
[color=#9aa4b8]Phone: joystick on the right half, hold RUN (bottom left) to sprint, tap answers / HELP / YES / NO, Back button = Esc.[/color]"
fit_content = true
scroll_active = false
autowrap_mode = 3

