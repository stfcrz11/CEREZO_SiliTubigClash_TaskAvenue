[node name="Rules" type="Label" parent="HowToPanel/Margin/VBox" unique_id=1084084316]
custom_minimum_size = Vector2(610, 0)
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/font_size = 15
text = "ROLES: 2-4 players = 1 Sili, 5-6 players = 2 Silis. Everyone else is Tubig. The Sili role rotates every round.

TUBIG TEAM: answer 10 questions about Filipino culture correctly before the 3-minute timer ends.
• Walk into a yellow ? scroll. Everyone freezes and sees the question; only the Tubig who picked it answers (click, tap, or 1-4). Help your teammate! Wrong = find another scroll.
• When a Sili comes near you get a warning: \"SILI NEARBY!\" then \"RUN!\".
• Caught Tubigs freeze. A teammate touches you to save you (1.5 s of safety + speed burst).

SILI: touch Tubigs to freeze them. Freeze every Tubig, or survive until time runs out, to win.

LAN: one player picks Host Game; the others pick Join Game on the same Wi-Fi or hotspot.
CONTROLS: W A S D or arrow keys to move, Shift or Space to sprint, Esc to pause (host)."
autowrap_mode = 3

