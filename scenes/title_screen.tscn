[node name="Rules" type="RichTextLabel" parent="HowToPanel/Margin/VBox/Scroll" unique_id=1084084316]
custom_minimum_size = Vector2(600, 0)
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 1
theme_override_colors/default_color = Color(0.92, 0.94, 0.98, 1)
theme_override_constants/line_separation = 5
theme_override_font_sizes/normal_font_size = 15
theme_override_font_sizes/bold_font_size = 15
theme_override_font_sizes/italics_font_size = 15
bbcode_enabled = true
text = "[center][color=#9aa4b8][i]A Filipino street chase game — with a quiz twist![/i][/color][/center]

[font_size=19][b][color=#ffd24d]ROLES[/color][/b][/font_size]
• 2–4 players → [color=#ff6155][b]1 Sili[/b][/color]   ·   5–6 players → [color=#ff6155][b]2 Silis[/b][/color]. Everyone else is [color=#5aa8ff][b]Tubig[/b][/color].
• The [color=#ff6155][b]Sili[/b][/color] role rotates every round.

[font_size=19][b][color=#5aa8ff]TUBIG TEAM[/color][/b][/font_size]
• Goal: answer [color=#6be38a][b]10 questions[/b][/color] about Filipino culture before time runs out.
• Time: [b]3:00[/b] for 1 [color=#5aa8ff][b]Tubig[/b][/color], [b]20 s less[/b] for each extra [color=#5aa8ff][b]Tubig[/b][/color] — you can answer at the same time.
• Walk into a [b]? scroll[/b] to get a question. Answer by click, tap or [bgcolor=#33405e][color=#ffffff][b] 1–4 [/b][/color][/bgcolor].
• [color=#ffd24d][b]Yellow dots[/b][/color] on your MAPA show where the scrolls are. The [color=#ff6155][b]Sili[/b][/color] can't see them — but may be waiting there!
• While you answer you [b]can't move[/b] and [b]can't be tagged[/b]. The others keep playing.
• Wrong answer? Find another scroll.
• A [color=#ff6155][b]Sili[/b][/color] is near? You get a warning: [color=#ffa53d][b]SILI NEARBY![/b][/color] then [color=#ff6155][b]RUN![/b][/color]
• Caught Tubigs freeze. A teammate touches you to save you ([b]1.5 s[/b] safety + speed burst).

[font_size=19][b][color=#6be38a]ASKING FOR HELP[/color][/b][/font_size]
• Stuck? Press [bgcolor=#33405e][color=#ffffff][b] ASK A TEAMMATE FOR HELP [/b][/color][/bgcolor] or [bgcolor=#33405e][color=#ffffff][b] H [/b][/color][/bgcolor].
• Only [b]one [color=#5aa8ff][b]Tubig[/b][/color][/b] can ask at a time.
• The [b]first free teammate[/b] who says [bgcolor=#33405e][color=#ffffff][b] YES (Y) [/b][/color][/bgcolor] gets your question with a fresh timer — and you are free to run.
• If you are the only [color=#5aa8ff][b]Tubig[/b][/color], the [color=#ff6155][b]Sili[/b][/color] waits while you answer.

[font_size=19][b][color=#ff6155]SILI[/color][/b][/font_size]
• Touch [color=#5aa8ff][b]Tubig[/b][/color]s to freeze them.
• Win by freezing [b]every[/b] [color=#5aa8ff][b]Tubig[/b][/color], or when time runs out.

[font_size=19][b][color=#ffd24d]PLAYING TOGETHER (LAN)[/color][/b][/font_size]
• One player picks [b]HOST GAME[/b]; the others pick [b]JOIN GAME[/b].
• Everyone must be on the same Wi-Fi or phone hotspot.

[font_size=19][b][color=#ffd24d]CONTROLS[/color][/b][/font_size]
[bgcolor=#33405e][color=#ffffff][b] W A S D [/b][/color][/bgcolor] or arrows — move
[bgcolor=#33405e][color=#ffffff][b] Shift [/b][/color][/bgcolor] or [bgcolor=#33405e][color=#ffffff][b] Space [/b][/color][/bgcolor] — sprint
[bgcolor=#33405e][color=#ffffff][b] 1 [/b][/color][/bgcolor] [bgcolor=#33405e][color=#ffffff][b] 2 [/b][/color][/bgcolor] [bgcolor=#33405e][color=#ffffff][b] 3 [/b][/color][/bgcolor] [bgcolor=#33405e][color=#ffffff][b] 4 [/b][/color][/bgcolor] — answer
[bgcolor=#33405e][color=#ffffff][b] H [/b][/color][/bgcolor] — ask for help      [bgcolor=#33405e][color=#ffffff][b] Y [/b][/color][/bgcolor] / [bgcolor=#33405e][color=#ffffff][b] N [/b][/color][/bgcolor] — answer a help request
[bgcolor=#33405e][color=#ffffff][b] Esc [/b][/color][/bgcolor] — pause (host only)
[b]On a phone:[/b] drag on the right half of the screen to move, hold [b]RUN[/b] (bottom left) to sprint, tap the answers and buttons. The Back button works like Esc."
fit_content = true
scroll_active = false

